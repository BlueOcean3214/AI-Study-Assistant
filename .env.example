# ===== 配置说明 =====
# 复制为 .env 后按需填写；.env 已在 .gitignore 中，不会被提交。
# 不要把真实 API Key 写进源码、测试或提交记录。
#
# 默认模式：阿里云百炼云端（LLM + Embedding 全走云端，不需要 Ollama）。
# 模型 / 地域 / Base URL 以百炼控制台实际可用配置为准，下面的值只是示例。

# ===== LLM（对话与工具调用）=====
# Provider：openai_compatible（默认，百炼等云端）或 ollama（本地回退）
LLM_PROVIDER=openai_compatible
# API 基地址（默认 https://dashscope.aliyuncs.com/compatible-mode/v1，按控制台核对）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API Key（必填；从百炼控制台获取）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 模型名（默认 qwen-plus；具体可用型号以控制台为准）
# LLM_MODEL=qwen-plus

# ===== Embedding（向量化）=====
# Provider：openai_compatible（默认，百炼等云端）或 ollama（本地回退）
EMBEDDING_PROVIDER=openai_compatible
# API 基地址（默认 https://dashscope.aliyuncs.com/compatible-mode/v1，按控制台核对）
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API Key（必填；可与 LLM_API_KEY 同值）
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
# 模型名（默认 text-embedding-v4；可用型号以控制台为准）
# EMBEDDING_MODEL=text-embedding-v4
# 向量维度（默认 1024；0 = 不传 dimensions、用模型默认维度）
#   注意：切换模型或维度后旧向量缓存自动判废归档，下次检索重建
# EMBEDDING_DIMENSIONS=1024
# 单次请求批量（云端默认 10，ollama 默认 32）
# EMBEDDING_BATCH_SIZE=10
# 单次请求超时秒数（默认 60）
# EMBEDDING_TIMEOUT=60

# ===== 本地 Ollama 回退（可选）=====
# 想跑本地模型时改用下面这组（本地开发 / 测试用，云端模式不需要）：
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# LLM_MODEL=qwen3.5:4b
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=1024
# 兼容旧配置（完整地址，优先级更高）
# OLLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_EMBED_URL=http://localhost:11434/api/embed
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_EMBED_MODEL=bge-m3

# ===== RAG 检索模式 =====
# vector（纯向量基线，默认）或 hybrid（向量 + BM25 关键词 + RRF 融合）
# RAG_RETRIEVAL_MODE=vector
# RAG 后端：custom（自研，默认）或 llamaindex（LlamaIndex 实验路径）
# RAG_BACKEND=custom
# LLAMAINDEX_STORE_DIR=.llamaindex_store
# 向量缓存目录（默认 .rag_cache/，按 provider:model@dim 身份自动判废重建）
# RAG_CACHE_DIR=.rag_cache

# ===== Rerank 第二阶段重排（可选；真实 API 未验证，以控制台为准）=====
# RAG_RERANK_ENABLED=0
# RERANK_PROVIDER=openai_compatible
# RERANK_BASE_URL=https://dashscope.aliyuncs.com
# RERANK_API_KEY=sk-xxxxxxxxxxxxxxxx
# RERANK_MODEL=qwen3-rerank
# RERANK_TOP_N=3
# RERANK_TIMEOUT=20
# 重排失败时是否回退未重排结果（1=回退并标注，0=直接报错）
# RERANK_FALLBACK=1

# ===== 上下文组装（P1-A：去重 + 字符预算，作用于检索结果进 LLM 之前）=====
# 进入 Prompt 的上下文字符预算（含来源标签与分隔符；0=不限制，默认 6000）
# 超预算时按检索顺序保留完整块，装不下的整块跳过并记日志，不截断来源标识
# CONTEXT_MAX_CHARS=6000

# ===== 计划草案引擎 / Prompt 版本（对照实验）=====
# PLAN_DRAFT_ENGINE=native（默认）或 langgraph（LangGraph 工作流实验）
# PLAN_DRAFT_ENGINE=native
# Prompt 变体切换（任务名见 prompt_registry.py）：
# PROMPT_VERSION_PLAN_DRAFT_SYSTEM=v1
# PROMPT_VERSION_ASK_RAG=v1

# ===== 模型调用重试（有限次数，429/5xx/连接失败才重试）=====
# LLM_MAX_RETRIES=2
# EMBEDDING_MAX_RETRIES=2

# ===== 数据库 / 用量记录 =====
# SQLite 路径（默认项目根目录 feedback.db）
# FEEDBACK_DB_PATH=feedback.db
# 模型用量记录（model_usage 表）：默认 1 启用；0 关闭。只记 token/耗时/状态，不记 Prompt
# MODEL_USAGE_ENABLED=1

# ===== LangChain 实验入口 =====
# 1 开启 LangChain 只读 Agent 的实验路由 /experiment/langchain/ask（默认关闭）
# LANGCHAIN_EXPERIMENT_ENABLED=0
